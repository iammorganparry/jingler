{
  "name": "@jingler/auth-state",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "description": "Per-user authorization state and revocable provider capabilities for managed execution.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 9450",
    "pretypecheck": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "clean": "rimraf .wrangler .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@jingler/tsconfig": "workspace:*",
    "rimraf": "^6.0.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "@jingler/core": "workspace:*"
  }
}
