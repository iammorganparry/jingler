{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jingler-auth-state",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "auth-state.jingler.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "MANAGED_RUNTIME_ORIGIN": "https://managed-runtime.jingler.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_STATE",
        "class_name": "AuthStateObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthStateObject"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
