{
  "name": "@jingler/memory-worker",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Organization-isolated Cloudflare memory vault, graph, analytics, and search service.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@jingler/core": "workspace:*",
    "@jingler/memory": "workspace:*",
    "effect": "^3.21.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@jingler/tsconfig": "workspace:*",
    "vitest": "^3.2.6",
    "wrangler": "^4.118.0"
  }
}
