{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jingler-device-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "device-relay.jingler.dev",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_REGISTRY",
        "class_name": "DeviceRegistryObject"
      },
      {
        "name": "SESSION_TUNNEL",
        "class_name": "SessionTunnelObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeviceRegistryObject", "SessionTunnelObject"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
