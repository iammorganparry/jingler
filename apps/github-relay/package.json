{
  "name": "@jingler/github-relay",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Verified GitHub webhooks and replayable realtime delivery for Jingler desktops.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 9200",
    "pretypecheck": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "deploy:dry": "wrangler deploy --dry-run",
    "clean": "rimraf dist .wrangler .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@jingler/tsconfig": "workspace:*",
    "rimraf": "^6.0.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
