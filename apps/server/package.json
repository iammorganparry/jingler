{
  "name": "@jingler/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Jingler auth and stateless MCP backend, hosted on Next.js with BetterAuth and Effect.",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "next dev --port 9100",
    "build": "pnpm email:bundle && NODE_ENV=production next build",
    "start": "next start --port 9100",
    "dev:hono": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsgo --noEmit",
    "email:dev": "email dev --dir src/emails --port 3010",
    "email:bundle": "esbuild src/emails/index.tsx --bundle --platform=node --format=esm --packages=external --minify --banner:js='// biome-ignore-all lint: generated deployment bundle' --outfile=src/emails-runtime.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:push:prod": "DRIZZLE_ENV_FILE=.env.prod drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "JINGLER_DB_TESTS=1 vitest run --config vitest.integration.config.ts",
    "skill:memory": "tsx scripts/generate-memory-skill.ts",
    "skill:memory:check": "tsx scripts/generate-memory-skill.ts --check",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@jingler/core": "workspace:*",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.4",
    "hono": "^4.12.30",
    "next": "16.2.11",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.17.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "devDependencies": {
    "@jingler/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "react-email": "^6.8.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
}
