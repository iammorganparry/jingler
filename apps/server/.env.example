# ── @jingler/server — auth backend ──────────────────────────────────────────
# Copy to .env for local dev. Dev works with ZERO real secrets: Docker Postgres
# + console magic links. OAuth + real email only needed to exercise those paths.

# Do NOT set NODE_ENV here. `next dev` sets it to `development`, `next build` to
# `production`; pinning it in .env makes `next build` produce a dev bundle (its
# React prerender of the synthesized /_not-found + /_global-error pages then
# crashes). `src/env.ts` already defaults NODE_ENV to `development` when unset.
PORT=9100

# Local Docker Postgres (see root docker-compose.yml). In prod point this at a
# managed Postgres behind a transaction-mode pooler (Supabase/Neon/PgBouncer).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/jingler

# BetterAuth. MUST be a strong random value in production (e.g. `openssl rand -hex 32`).
BETTER_AUTH_SECRET=dev-insecure-secret-change-me
BETTER_AUTH_URL=http://localhost:9100

# Deep link the desktop app registers. OAuth/magic-link bounce back here.
DESKTOP_REDIRECT=jingler://auth/callback

# GitHub OAuth app → Authorization callback URL: http://localhost:9100/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Shared GitHub App product integration. This is separate from GitHub social
# login above. The App callback is /api/github/callback and its setup URL is
# /api/github/setup. Keep the PEM on one line with literal \n escapes in hosted
# environment dashboards. Production uses BETTER_AUTH_URL=https://api.jingler.dev
# and GITHUB_APP_RELAY_URL=https://github-relay.jingler.dev. Leave disabled for
# zero-configuration local auth.
GITHUB_APP_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_RELAY_URL=http://localhost:9200
GITHUB_APP_RELAY_SIGNING_SECRET=
# Versioned OAuth-token encryption is deliberately independent from relay HMAC
# signing. During rotation, move the old value to PREVIOUS until rows have been
# naturally re-encrypted with the new current key.
GITHUB_APP_TOKEN_ENCRYPTION_KEY=
GITHUB_APP_TOKEN_ENCRYPTION_PREVIOUS_KEY=

# Google OAuth client → Authorized redirect URI: http://localhost:9100/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (magic-link email in prod). Leave blank in dev to log links to the console.
RESEND_API_KEY=
EMAIL_FROM=Jingler <login@jingler.local>

# Stateless team-memory grants and the private Cloudflare Worker hop.
MEMORY_ENABLED=true
MEMORY_GRANT_SECRET=dev-memory-grant-secret-change-me
MEMORY_GRANT_AUDIENCE=jingler-memory-mcp
MEMORY_GRANT_TTL_SECONDS=3600
MEMORY_WORKER_URL=http://localhost:8787
MEMORY_WORKER_SERVICE_SECRET=dev-memory-worker-secret-change-me
MEMORY_REQUEST_TIMEOUT_MS=5000
# Vercel sends this bearer to scheduled maintenance endpoints. Generate at least 32 random bytes.
CRON_SECRET=
