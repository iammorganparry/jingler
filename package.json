{
  "name": "jingler",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "pnpm version:check && pnpm runtime-contracts:check && turbo run typecheck",
    "test": "vitest run && pnpm --filter @jingler/github-relay test && pnpm --filter @jingler/device-relay test && pnpm --filter @jingler/auth-state test && pnpm --filter @jingler/managed-runtime test",
    "certify:native": "pnpm --filter @jingler/cli-adapters eval:native:live",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint . && pnpm lint:complexity",
    "lint:anti-slop": "NODE_OPTIONS=--experimental-strip-types oxlint",
    "lint:complexity": "oxlint -c .oxlintrc-complexity.json .",
    "perf": "node scripts/perf/perf.mjs",
    "license:check": "node scripts/licenses/check-production-licenses.mjs",
    "artifacts:check": "node scripts/artifacts/check-packaged-artifacts.mjs",
    "clean": "turbo run clean && rimraf node_modules",
    "changeset": "changeset",
    "version:check": "node scripts/check-version-policy.mjs",
    "runtime-contracts:check": "node scripts/sync-release-certification-manifest.mjs --check",
    "runtime-contracts:sync": "node scripts/sync-release-certification-manifest.mjs",
    "version-packages": "changeset version && node scripts/sync-app-version.mjs && node scripts/check-version-policy.mjs",
    "lint:fix": "biome lint --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@changesets/cli": "^2.27.10",
    "@electron/asar": "3.4.1",
    "@oxlint/plugins": "1.79.0",
    "@vitest/coverage-v8": "^3.2.6",
    "oxlint": "1.79.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.4",
    "typescript": "^7.0.2",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "esbuild",
      "@homebridge/node-pty-prebuilt-multiarch"
    ],
    "patchedDependencies": {
      "pi-subagents@0.65.0": "patches/pi-subagents@0.65.0.patch"
    }
  }
}
