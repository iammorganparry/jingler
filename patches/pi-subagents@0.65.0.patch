diff --git a/src/runs/shared/process-child-session-worker.ts b/src/runs/shared/process-child-session-worker.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b74f34a6b96f13721a755c8fdfc054c03cd6e954
--- /dev/null
+++ b/src/runs/shared/process-child-session-worker.ts
@@ -0,0 +1,92 @@
+import { createInterface } from "node:readline"
+import { createChildHooks } from "./child-hooks.ts"
+import {
+  createDefaultChildSessionFactory,
+  type ChildSession,
+  type ChildSessionLaunch
+} from "./child-session.ts"
+
+const send = (value: unknown): void => {
+  process.stdout.write(`${JSON.stringify(value)}\n`)
+}
+
+let session: ChildSession | undefined
+let factory: ReturnType<typeof createDefaultChildSessionFactory> | undefined
+
+const respond = async (message: Record<string, unknown>): Promise<void> => {
+  const id = typeof message.id === "string" ? message.id : undefined
+  try {
+    if (message.type === "init") {
+      const launch = message.launch as ChildSessionLaunch
+      const runtime = launch.runtime
+      if (runtime.structuredOutput) {
+        runtime.structuredOutput.capture = (value, acceptanceReport) =>
+          send({ type: "callback", callback: "structuredOutput", value, acceptanceReport })
+      }
+      runtime.watchdogStatus = (event) =>
+        send({ type: "callback", callback: "watchdogStatus", event })
+      runtime.toolDiagnostic = (diagnostic) =>
+        send({ type: "callback", callback: "toolDiagnostic", diagnostic })
+      runtime.runtimeAcknowledgements = (ids) =>
+        send({ type: "callback", callback: "runtimeAcknowledgements", ids })
+      launch.hooks = createChildHooks(runtime)
+      launch.onExtensionError = (error) => send({
+        type: "callback",
+        callback: "extensionError",
+        error: {
+          extensionPath: error.extensionPath,
+          event: error.event,
+          message: error.error instanceof Error ? error.error.message : String(error.error)
+        }
+      })
+      factory = createDefaultChildSessionFactory()
+      session = await factory.create(launch)
+      session.subscribe((event) => send({ type: "event", event }))
+      send({
+        type: "ready",
+        sessionFile: session.sessionFile,
+        sessionId: session.sessionId,
+        modelId: session.modelId
+      })
+      return
+    }
+    if (!session) throw new Error("Child session is not initialized")
+    if (message.type === "prompt") await session.prompt(String(message.text ?? ""))
+    else if (message.type === "steer") await session.steer(String(message.text ?? ""))
+    else if (message.type === "followUp") await session.followUp(String(message.text ?? ""))
+    else if (message.type === "abort") await session.abort()
+    else if (message.type === "dispose") {
+      await session.dispose()
+      await factory?.dispose()
+    } else throw new Error(`Unknown child session command: ${String(message.type)}`)
+    if (id && message.type === "dispose") {
+      process.stdout.write(
+        `${JSON.stringify({ type: "response", id, success: true })}\n`,
+        () => process.exit(0)
+      )
+      return
+    }
+    if (id) send({ type: "response", id, success: true })
+  } catch (error) {
+    if (id) send({
+      type: "response",
+      id,
+      success: false,
+      error: error instanceof Error ? error.message : String(error)
+    })
+    else send({ type: "fatal", error: error instanceof Error ? error.message : String(error) })
+  }
+}
+
+const lines = createInterface({ input: process.stdin })
+lines.on("line", (line) => {
+  let message: unknown
+  try {
+    message = JSON.parse(line)
+  } catch {
+    send({ type: "fatal", error: "Malformed child session command" })
+    return
+  }
+  if (!message || typeof message !== "object" || Array.isArray(message)) return
+  void respond(message as Record<string, unknown>)
+})
diff --git a/src/runs/shared/process-child-session.ts b/src/runs/shared/process-child-session.ts
new file mode 100644
index 0000000000000000000000000000000000000000..84c1137923b9c6a73e11424fc9457fa4d39fffec
--- /dev/null
+++ b/src/runs/shared/process-child-session.ts
@@ -0,0 +1,228 @@
+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process"
+import { createHash } from "node:crypto"
+import * as fs from "node:fs"
+import * as path from "node:path"
+import { createRequire } from "node:module"
+import { createInterface } from "node:readline"
+import { fileURLToPath } from "node:url"
+import type {
+  ChildSession,
+  ChildSessionEvent,
+  ChildSessionFactory,
+  ChildSessionLaunch
+} from "./child-session.ts"
+
+const require = createRequire(import.meta.url)
+const SAFE_AGENT = /^[a-z][a-z0-9-]*$/u
+
+const jitiCli = (): string => {
+  const packageJson = require.resolve("jiti/package.json")
+  const root = path.dirname(packageJson)
+  const manifest = JSON.parse(fs.readFileSync(packageJson, "utf8")) as {
+    bin?: string | Record<string, string>
+  }
+  const bin = typeof manifest.bin === "string"
+    ? manifest.bin
+    : manifest.bin?.jiti ?? Object.values(manifest.bin ?? {})[0]
+  if (!bin) throw new Error("Could not resolve jiti CLI")
+  return path.resolve(root, bin)
+}
+
+export const isolatedChildEnvironment = (launch: ChildSessionLaunch): NodeJS.ProcessEnv => {
+  const env = { ...process.env, ...launch.processEnv }
+  for (const key of [
+    "ANTHROPIC_API_KEY",
+    "ANTHROPIC_AUTH_TOKEN",
+    "ANTHROPIC_BASE_URL",
+    "CLAUDE_CODE_USE_BEDROCK",
+    "CLAUDE_CODE_USE_ANTHROPIC_AWS",
+    "CLAUDE_CODE_USE_VERTEX",
+    "CLAUDE_CODE_USE_FOUNDRY"
+  ]) delete env[key]
+  const root = env.JINGLER_SUBAGENT_CREDENTIAL_ROOT
+  const parent = launch.runtime.parentSessionId ?? launch.runtime.orchestratorSessionId
+  const agent = launch.runtime.agent
+  if (!root || !parent || !agent || !SAFE_AGENT.test(agent)) {
+    throw new Error("Jingler child credentials require a valid parent session and agent")
+  }
+  const agentDir = path.join(root, createHash("sha256").update(parent).digest("hex"))
+  const authPath = path.join(agentDir, "auth.json")
+  const capabilityPath = path.join(agentDir, `capability-${agent}.json`)
+  for (const file of [authPath, capabilityPath]) {
+    const stat = fs.statSync(file)
+    if (process.platform !== "win32" && (stat.mode & 0o777) !== 0o600) {
+      throw new Error(`Jingler child credential permissions are not restricted: ${file}`)
+    }
+  }
+  env.PI_CODING_AGENT_DIR = agentDir
+  env.JINGLER_SUBAGENT_CAPABILITY = capabilityPath
+  env.PI_SUBAGENT_CHILD = "1"
+  env.PI_SUBAGENT_PARENT_SESSION = parent
+  if (env.PI_SUBAGENT_ELECTRON_RUN_AS_NODE === "1") env.ELECTRON_RUN_AS_NODE = "1"
+  delete env.JINGLER_SUBAGENT_CREDENTIAL_ROOT
+  return env
+}
+
+interface PendingCommand {
+  resolve: () => void
+  reject: (error: Error) => void
+}
+
+const serializableLaunch = (launch: ChildSessionLaunch): ChildSessionLaunch => ({
+  ...launch,
+  hooks: [],
+  onExtensionError: undefined,
+  runtime: {
+    ...launch.runtime,
+    watchdogStatus: undefined,
+    toolDiagnostic: undefined,
+    runtimeAcknowledgements: undefined,
+    ...(launch.runtime.structuredOutput
+      ? { structuredOutput: { ...launch.runtime.structuredOutput, capture: undefined as never } }
+      : {})
+  }
+})
+
+const startChild = (launch: ChildSessionLaunch): Promise<ChildSession> =>
+  new Promise((resolve, reject) => {
+    const node = process.env.JINGLER_SUBAGENT_NODE ?? process.execPath
+    const fixtureWorker = process.env.JINGLER_SUBAGENT_PROCESS_WORKER?.trim()
+    const worker = fileURLToPath(new URL("./process-child-session-worker.ts", import.meta.url))
+    const child: ChildProcessWithoutNullStreams = spawn(
+      node,
+      fixtureWorker ? [fixtureWorker] : [jitiCli(), worker],
+      {
+      cwd: launch.cwd,
+      env: isolatedChildEnvironment(launch),
+      stdio: ["pipe", "pipe", "pipe"],
+      windowsHide: true
+    })
+    const listeners = new Set<(event: ChildSessionEvent) => void>()
+    const pending = new Map<string, PendingCommand>()
+    const messages: unknown[] = []
+    let sequence = 0
+    let ready = false
+    let disposed = false
+    let stderr = ""
+    const command = (type: string, text?: string): Promise<void> => {
+      if (disposed) return Promise.reject(new Error("Child session is disposed"))
+      const id = `command-${++sequence}`
+      child.stdin.write(`${JSON.stringify({ id, type, ...(text === undefined ? {} : { text }) })}\n`)
+      return new Promise((resolveCommand, rejectCommand) => {
+        pending.set(id, { resolve: resolveCommand, reject: rejectCommand })
+      })
+    }
+    const fail = (error: Error, terminate = false): void => {
+      if (!ready) reject(error)
+      for (const waiter of pending.values()) waiter.reject(error)
+      pending.clear()
+      if (terminate && child.exitCode === null) child.kill("SIGTERM")
+    }
+    const startupTimer = setTimeout(() => {
+      fail(new Error(stderr.trim() || "Child session did not start within 10 seconds"), true)
+    }, 10_000)
+    startupTimer.unref?.()
+    child.stderr.on("data", (chunk: Buffer) => {
+      stderr = `${stderr}${chunk.toString("utf8")}`.slice(-64 * 1024)
+    })
+    child.on("error", (error) => fail(error, true))
+    child.on("close", (code) => {
+      clearTimeout(startupTimer)
+      const unfinished = !ready || pending.size > 0
+      disposed = true
+      if (code !== 0 || unfinished) {
+        fail(new Error(stderr.trim() || `Child session exited with code ${code}`))
+      }
+    })
+    createInterface({ input: child.stdout }).on("line", (line) => {
