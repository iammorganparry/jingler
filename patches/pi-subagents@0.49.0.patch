+/**
+ * A caller-supplied script that wraps exactly one child gains nothing over the
+ * structured { agent, task } form and costs the operator visibility (a workflow
+ * root has no transcript of its own). Deliberately conservative: anything that
+ * could spawn more than one child — runs.all, several runs.run call sites, or
+ * a loop/map — passes through untouched.
+ */
+export function isSingleChildWorkflowScript(script: string): boolean {
+	const runCalls = script.match(/runs\.run\s*\(/g)?.length ?? 0;
+	if (runCalls !== 1) return false;
+	if (/runs\.all\s*\(/.test(script)) return false;
+	if (/\bfor\b|\bwhile\b|\.map\s*\(|\.forEach\s*\(/.test(script)) return false;
+	// Resuming one retained child is only expressible as a runs.run item.
+	if (/\bresume\s*:/.test(script)) return false;
+	return true;
+}
