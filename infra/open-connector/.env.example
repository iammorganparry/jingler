# Copy to .env and fill in. See the OpenConnector docs for the full list:
#   http://localhost:3000/docs   (once running)

# A long random string OpenConnector uses to encrypt stored provider credentials.
# Generate with: openssl rand -hex 32
OPEN_CONNECTOR_ENCRYPTION_KEY=

# The bearer token clients must present to call /mcp and /v1/actions/*. This is the
# value you paste into Jingler → Settings → Unified MCP (stored in the OS keychain,
# never in config.json). Generate with: openssl rand -hex 32
OPEN_CONNECTOR_API_TOKEN=

# Public base URL of this instance, without the /mcp suffix (used for OAuth
# redirect URLs). For local dev this is the console origin.
OPEN_CONNECTOR_BASE_URL=http://localhost:3000
