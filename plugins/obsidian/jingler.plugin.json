{
  "$schema": "../../packages/plugin-sdk/jingler.plugin.schema.json",
  "id": "obsidian",
  "name": "Obsidian",
  "version": "1.0.1",
  "apiVersion": 1,
  "description": "Browse a local Markdown vault and let this session's agent update notes.",
  "ui": "dist/ui.js",
  "main": "dist/main.js",
  "activationEvents": [
    "onTab:obsidian.notes"
  ],
  "contributes": {
    "tabs": [
      {
        "id": "obsidian.notes",
        "label": "Obsidian",
        "icon": "BookOpen",
        "when": "always"
      }
    ],
    "agentToolsets": [
      {
        "id": "obsidian.vault",
        "label": "Obsidian vault",
        "description": "List, read, and update existing Markdown notes in the vault configured for this session. Read before writing; a revision is required."
      }
    ],
    "commands": [
      {
        "id": "obsidian.configuration",
        "title": "Load vault configuration"
      },
      {
        "id": "obsidian.configure",
        "title": "Configure session vault"
      },
      {
        "id": "obsidian.list",
        "title": "List vault notes"
      },
      {
        "id": "obsidian.read",
        "title": "Preview vault note"
      }
    ]
  }
}
