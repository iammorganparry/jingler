{
  "name": "@jingler/plugin-obsidian",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "description": "Official local Markdown vault plugin for Jingler.",
  "scripts": {
    "build": "vite build && node --import tsx ./scripts/emit-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@xstate/react": "^6.0.0",
    "xstate": "^5.25.0"
  },
  "devDependencies": {
    "@jingler/plugin-sdk": "workspace:*",
    "@jingler/tsconfig": "workspace:*",
    "@types/react": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "@types/node": "^24.0.0"
  }
}
