{
  "name": "@jingler/plugin-debug",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "DAP debugging and live runtime state for Jingler.",
  "scripts": {
    "build": "vite build && tsx ./scripts/emit-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@jingler/core": "workspace:*",
    "valibot": "1.4.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@jingler/plugin-sdk": "workspace:*",
    "@jingler/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
