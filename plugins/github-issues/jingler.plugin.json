{
  "$schema": "../../packages/plugin-sdk/jingler.plugin.schema.json",
  "id": "github-issues",
  "name": "GitHub Issues",
  "version": "1.2.0",
  "description": "Read the issue linked to a session, without leaving Jingler.",
  "ui": "dist/ui.js",
  "main": "dist/main.js",
  "activationEvents": [
    "onTab:github-issues.issue"
  ],
  "contributes": {
    "tabs": [
      {
        "id": "github-issues.issue",
        "label": "Issue",
        "icon": "CircleDot",
        "order": 10,
        "when": {
          "issueProvider": "github"
        }
      }
    ],
    "commands": [
      {
        "id": "github-issues.fetch",
        "title": "Fetch linked issue",
        "category": "GitHub"
      }
    ]
  }
}
