{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "VITEST_MAX_WORKERS"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "AUTH_STATE_SERVICE_SECRET",
        "AUTH_STATE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CRON_SECRET",
        "DATABASE_URL",
        "DESKTOP_REDIRECT",
        "DEVICE_BOOTSTRAP_TTL_SECONDS",
        "DEVICE_RELAY_ENABLED",
        "DEVICE_RELAY_GRANT_TTL_SECONDS",
        "DEVICE_RELAY_SIGNING_SECRET",
        "DEVICE_RELAY_URL",
        "EMAIL_FROM",
        "GITHUB_APP_CLIENT_ID",
        "GITHUB_APP_CLIENT_SECRET",
        "GITHUB_APP_ENABLED",
        "GITHUB_APP_ID",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_APP_RELAY_SIGNING_SECRET",
        "GITHUB_APP_RELAY_URL",
        "GITHUB_APP_TOKEN_ENCRYPTION_KEY",
        "GITHUB_APP_TOKEN_ENCRYPTION_PREVIOUS_KEY",
        "GITHUB_APP_WEBHOOK_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "MANAGED_CHECKPOINT_RETENTION_SECONDS",
        "MANAGED_DAILY_BUDGET_MICROUSD",
        "MANAGED_ENVIRONMENTS_ENABLED",
        "MANAGED_MAX_ACTIVE_SECONDS",
        "MANAGED_MAX_CHECKPOINT_BYTES",
        "MANAGED_MAX_CONCURRENT_SESSIONS",
        "MANAGED_MAX_EGRESS_BYTES",
        "MANAGED_RUNTIME_SERVICE_SECRET",
        "MANAGED_RUNTIME_URL",
        "MEMORY_ENABLED",
        "MEMORY_GRANT_AUDIENCE",
        "MEMORY_GRANT_SECRET",
        "MEMORY_GRANT_TTL_SECONDS",
        "MEMORY_REQUEST_TIMEOUT_MS",
        "MEMORY_WORKER_SERVICE_SECRET",
        "MEMORY_WORKER_URL",
        "OFFLOAD_COMPUTE_ENABLED",
        "RESEND_API_KEY"
      ],
      "outputs": [
        "dist/**",
        "out/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
