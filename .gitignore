node_modules/
dist/
out/
.turbo/
storybook-static/
*.log
.DS_Store
.env
.env.*
.env.local

# Cloudflare Worker local secrets (wrangler). The committed template is
# .dev.vars.example; the real .dev.vars (turbopuffer key, etc.) never lands in git.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Generated by `pnpm --filter @jingler/github-relay types`; recreated before typecheck.
apps/github-relay/worker-configuration.d.ts
coverage/
*.tsbuildinfo

# Playwright e2e
test-results/
playwright-report/
blob-report/
.playwright/

# electron-builder output
release/

# Stray files written into the repo by tools that are not this project.
#
# MCP servers configured with a RELATIVE data path write wherever the agent's
# cwd happens to be, which is a session's worktree. `data/wowlogs-mcp.db` turned
# up in two worktrees this way — nothing to do with Jingler, but it shows up as
# untracked in every `git status` and invites being committed by accident.
#
# Anchored at the repo root, so a legitimate nested fixture dir
# (`packages/*/data/`) is still tracked.
/data/

# Next.js build output
.next/
next-env.d.ts
.vercel
.env*.local

# Design-sync tooling artifacts. These are generated bundles/exports (~150M),
# not source; left untracked they flood `git status` and the Files tab tree,
# which lists untracked files.
/.design-sync/
/.ds-sync/
/ds-bundle/
