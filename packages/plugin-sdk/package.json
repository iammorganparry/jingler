{
  "name": "@jingler/plugin-sdk",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Types and helpers for writing a Jingler plugin — the renderer half (`.`) and the extension-host half (`./host`).",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.ts",
    "./ui-exports": "./src/ui-exports.ts",
    "./host": "./src/host.ts",
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.mjs"
    }
  },
  "files": [
    "src",
    "vite.mjs",
    "vite.d.ts",
    "jingler.plugin.schema.json",
    "AGENTS.md",
    "api-digest.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen:schema": "tsx ../../scripts/gen-plugin-schema.mjs",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "@jingler/ui": "workspace:*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@jingler/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jingler/core": "workspace:*",
    "@jingler/tsconfig": "workspace:*",
    "@jingler/ui": "workspace:*",
    "@types/react": "^19.2.0",
    "expect-type": "^1.4.0",
    "react": "^19.2.0",
    "tsx": "^4.23.1"
  }
}
